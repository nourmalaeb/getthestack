# Production: a GitHub App (Settings → Developer settings → GitHub Apps).
# Permissions: Pull requests (read). The installation ID is the number at the
# end of the app's installation settings URL.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Local dev alternative: a personal token, e.g. `gh auth token`.
# Ignored when the GitHub App variables are set.
GITHUB_TOKEN=
